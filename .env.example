# .env.example for RWA Arbitrage Dashboard

# Required Environment Variables

# API_URL
# The base URL of the API used by the dashboard

# NODE_ENV
# The environment mode (development, production, etc.)

# PORT
# The port on which the server will run (default: 3000)

# DATABASE_URI
# The URI for the database connection

# REDIS_URL
# The URL for the Redis cache connection

# JWT_SECRET
# The secret key for JWT authentication

# LOG_LEVEL
# The logging level to be used (debug, info, warn, error)

# OPTIONAL (if needed)

# FRONTEND_URL
# The URL of the frontend application

# SMTP_SERVER
# The SMTP server for sending emails

# SMTP_USER
# The username for the SMTP server

# SMTP_PASSWORD
# The password for the SMTP server
